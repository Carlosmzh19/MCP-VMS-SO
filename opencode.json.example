{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "virtualbox_ssh": {
      "type": "local",
      "command": [
        "${workspaceFolder}/.venv/Scripts/python.exe",
        "${workspaceFolder}/server.py"
      ],
      "cwd": "${workspaceFolder}",
      "enabled": true,
      "timeout": 120000
    }
  }
}
